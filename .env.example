# Optional server-side fallback API keys. Copy this file to `.env.local`.
# Keys can also be entered per-provider in the app's Settings panel (stored in
# the browser), so these env vars are only a fallback for the chosen provider.

# Anthropic (Claude) — https://console.anthropic.com/
ANTHROPIC_API_KEY=

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Google Gemini — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Mimo (Xiaomi, OpenAI-compatible) — https://xiaomimimo.com/
MIMO_API_KEY=

# Optional: override where the draw.io editor is loaded from. Defaults to this
# app's own self-hosted copy at <origin>/drawio/index.html. Set to a CDN or
# https://embed.diagrams.net to use a hosted editor instead.
# NEXT_PUBLIC_DRAWIO_BASE_URL=

# Shared password gate (HTTP Basic Auth via middleware.ts). When the app is
# exposed publicly (e.g. a Cloudflare quick tunnel), every visitor must enter
# this password. Falls back to a built-in default if unset — always set your own
# before going public. Username can be anything; only the password is checked.
APP_PASSWORD=
