{
  "name": "diagramforge",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3005",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "setup:drawio": "bash scripts/setup-drawio.sh",
    "tunnel": "cloudflared tunnel --url http://localhost:3005",
    "dev:public": "concurrently -k -n next,tunnel -c blue,magenta \"npm:dev\" \"npm:tunnel\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.2",
    "next": "^15.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-drawio": "^1.0.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "concurrently": "^10.0.3",
    "typescript": "^5.7.0"
  }
}
